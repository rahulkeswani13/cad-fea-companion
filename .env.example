# Google AI Studio / Gemini API key
GEMINI_API_KEY=

GEMINI_MODEL=gemini-3.5-flash

# FreeCADCmd path override (optional; auto-detected on macOS)
# FREECAD_CMD=/Applications/FreeCAD.app/Contents/Resources/bin/FreeCADCmd

# Server (keep HOST=127.0.0.1 unless you set ALLOW_REMOTE=true)
HOST=127.0.0.1
PORT=8000
ALLOW_REMOTE=false

# Use analytical FEM fallback when FreeCAD CalculiX is unavailable
FEM_ALLOW_ANALYTICAL_FALLBACK=true

# LangGraph agent loop
AGENT_MAX_TOOL_ROUNDS=6
# Ask before FreeCAD-mutating tools (create/solve/open). Keep false for one-shot demos.
AGENT_REQUIRE_TOOL_CONFIRM=false

# RAG grounding label (ADR-012): 'strong' needs the fused top hit to clear the
# TF-IDF cosine floor OR sit within the BM25 top-N. Defaults: 0.05 / 3.
RAG_GROUNDING_MIN_TFIDF=0.05
RAG_GROUNDING_BM25_TOP=3

# Curated RAG corpus (ADR-014): only files under these dirs (comma-separated,
# relative to the repo root) are ingested — everything else fails closed.
# Defaults are usually right; uncomment to override.
# RAG_CORPUS_DIRS=docs/reference,docs/adr
